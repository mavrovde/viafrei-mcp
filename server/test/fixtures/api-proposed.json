{
  "x-source": {
    "comment": "Proposed operations, not in a released API: the paths this branch asks the API for, each marked x-proposed. They are merged into the contract fixture (api-openapi.json, the API's own document) by scripts/gen-operations.mjs and test/api-mock.ts; the MCP sends a request to one only once the API's own OpenAPI document lists it."
  },
  "paths": {
    "/v1/places/resolve": {
      "get": {
        "x-proposed": true,
        "operationId": "resolvePlace",
        "summary": "Proposed: the one place a free text names (today's MCP resolver, moved to the API)",
        "description": "Proposed, not in a released API. The one place a free text names, as today's server resolves it: a town by its gazetteer point (GeoNames where it holds one, else the official centre), a stop or a POI where the text names one ('Berlin Alexanderplatz'), the other places of the same name said as alternatives ('Sylt (town), also: Sylt (island)'). The label is what the answer says; meta.attribution credits the sources the place came from. data is null when the text names no place. An API without the operation answers 404, and the MCP then reads listPlaces as before.",
        "tags": [
          "places"
        ],
        "parameters": [
          {
            "description": "The place name as typed: case, umlauts written out (koeln for Köln), accents and punctuation do not matter; any of its names (an English one too) answers.",
            "explode": false,
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "The place name as typed: case, umlauts written out (koeln for Köln), accents and punctuation do not matter; any of its names (an English one too) answers.",
              "examples": [
                "Neustadt"
              ],
              "maxLength": 80,
              "minLength": 2,
              "type": "string"
            }
          },
          {
            "description": "The language of the answer's texts (de, en): the source notes, rules texts and notices. Default: the instance's language, German.",
            "example": "en",
            "in": "query",
            "name": "lang",
            "schema": {
              "enum": [
                "de",
                "en"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The place, or null.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "name",
                            "label",
                            "kind",
                            "location"
                          ],
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "label": {
                              "type": "string",
                              "description": "What the answer says of the place, with its kind and the alternatives where the name is shared."
                            },
                            "kind": {
                              "type": "string",
                              "enum": [
                                "municipality",
                                "district",
                                "region",
                                "island",
                                "station_area",
                                "stop",
                                "poi",
                                "junction",
                                "motorway"
                              ]
                            },
                            "location": {
                              "type": "object",
                              "required": [
                                "lat",
                                "lon"
                              ],
                              "properties": {
                                "lat": {
                                  "type": "number"
                                },
                                "lon": {
                                  "type": "number"
                                }
                              }
                            },
                            "districtCode": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "alternatives": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": [
                                  "name",
                                  "kind"
                                ],
                                "properties": {
                                  "name": {
                                    "type": "string"
                                  },
                                  "kind": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      ]
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not used by this operation.",
            "headers": {
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimit-Policy"
              }
            }
          }
        }
      }
    },
    "/v1/stop-boards": {
      "get": {
        "x-proposed": true,
        "operationId": "listStopBoards",
        "summary": "Proposed: the stops around a place with their next departures, in one read",
        "description": "Proposed, not in a released API. The stops around a place (q, resolved as resolvePlace does) or a position (at), chosen and ordered as today's server chooses them (one row per stop, the station a place names first), each with its next departures in the window. stopId is the GTFS stop_id as the timetable spells it (no feed prefix), what get_departures takes back. data is null when q names no place. An API without the operation answers 404, and the MCP then reads listStations and one board per stop as before.",
        "tags": [
          "transit"
        ],
        "parameters": [
          {
            "description": "A place name, resolved as resolvePlace does. One of q or at.",
            "explode": false,
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80,
              "description": "A place name, resolved as resolvePlace does. One of q or at."
            }
          },
          {
            "description": "A position: lat,lon in decimal degrees (WGS 84). With q, the name search within radius_m of it. At least one of q and at.",
            "explode": false,
            "in": "query",
            "name": "at",
            "schema": {
              "description": "A position: lat,lon in decimal degrees (WGS 84). With q, the name search within radius_m of it. At least one of q and at.",
              "examples": [
                "50.943,6.959"
              ],
              "pattern": "^-?[0-9]{1,3}(\\.[0-9]+)?,-?[0-9]{1,3}(\\.[0-9]+)?$",
              "type": "string"
            }
          },
          {
            "description": "How far around the point stops are taken, in metres; default 5000.",
            "explode": false,
            "in": "query",
            "name": "radius_m",
            "schema": {
              "type": "integer",
              "minimum": 100,
              "maximum": 5000,
              "description": "How far around the point stops are taken, in metres; default 5000."
            }
          },
          {
            "description": "Most stops; default 8.",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "Most stops; default 8."
            }
          },
          {
            "description": "Most departures per stop; default 4.",
            "explode": false,
            "in": "query",
            "name": "per_stop",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 15,
              "description": "Most departures per stop; default 4."
            }
          },
          {
            "description": "Start of the window (RFC 3339 with an offset); default: now. The board lists the departures planned from it.",
            "explode": false,
            "in": "query",
            "name": "from",
            "schema": {
              "description": "Start of the window (RFC 3339 with an offset); default: now. The board lists the departures planned from it.",
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Length of the window in minutes; default 60. To look further ahead, move from rather than widen the window.",
            "explode": false,
            "in": "query",
            "name": "duration_min",
            "schema": {
              "description": "Length of the window in minutes; default 60. To look further ahead, move from rather than widen the window.",
              "format": "int64",
              "maximum": 1440,
              "minimum": 5,
              "type": "integer"
            }
          },
          {
            "description": "Keep only these modes (comma-separated): rail, sbahn, subway, tram, bus, ferry, other. Default: every mode.",
            "explode": false,
            "in": "query",
            "name": "modes",
            "schema": {
              "description": "Keep only these modes (comma-separated): rail, sbahn, subway, tram, bus, ferry, other. Default: every mode.",
              "items": {
                "type": "string"
              },
              "maxItems": 7,
              "type": "array"
            }
          },
          {
            "description": "The language of the answer's texts (de, en): the source notes, rules texts and notices. Default: the instance's language, German.",
            "example": "en",
            "in": "query",
            "name": "lang",
            "schema": {
              "enum": [
                "de",
                "en"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The place and its stops, or null.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "place",
                            "window",
                            "stops"
                          ],
                          "properties": {
                            "place": {
                              "type": "object",
                              "required": [
                                "label",
                                "location"
                              ],
                              "properties": {
                                "label": {
                                  "type": "string"
                                },
                                "location": {
                                  "type": "object"
                                }
                              }
                            },
                            "window": {
                              "type": "object",
                              "required": [
                                "from",
                                "until"
                              ],
                              "properties": {
                                "from": {
                                  "type": "string"
                                },
                                "until": {
                                  "type": "string"
                                }
                              }
                            },
                            "stops": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": [
                                  "id",
                                  "name",
                                  "stopId",
                                  "distanceM",
                                  "departures"
                                ],
                                "properties": {
                                  "id": {
                                    "type": "string"
                                  },
                                  "name": {
                                    "type": "string"
                                  },
                                  "stopId": {
                                    "type": "string"
                                  },
                                  "distanceM": {
                                    "type": "integer"
                                  },
                                  "departures": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "description": "As a board's departure (listStationDepartures)."
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      ]
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not used by this operation.",
            "headers": {
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimit-Policy"
              }
            }
          }
        }
      }
    },
    "/v1/stations/{stationId}/page": {
      "get": {
        "x-proposed": true,
        "operationId": "getStationPage",
        "summary": "Proposed: a station's page, its sections built by the page's rules",
        "description": "Proposed, not in a released API. The station page of viafrei.de as data: its sections in the page's order (header with the address, the Land in the asked language and DB's category; the rail lamp with its reasons and the lamp per line; step-free now; the lifts and escalators with their states, out of service first; the platforms; the board's first departures; the service alerts; parking and charging), each with its asOf and the sources it was built from, and pageUrl in the asked language. meta.attribution credits every section's sources once. data is null for a station the page register does not hold. An API without the operation answers 404, and the MCP then reads the facilities and the board as before.",
        "tags": [
          "transit"
        ],
        "parameters": [
          {
            "description": "The station id, as listStations answers it.",
            "in": "path",
            "name": "stationId",
            "required": true,
            "schema": {
              "description": "The station id, as listStations answers it.",
              "examples": [
                "1:de:05315:11201"
              ],
              "maxLength": 120,
              "minLength": 3,
              "type": "string"
            }
          },
          {
            "description": "The board's first departures shown; default 5, 0 for none.",
            "explode": false,
            "in": "query",
            "name": "departures",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "description": "The board's first departures shown; default 5, 0 for none."
            }
          },
          {
            "description": "The language of the answer's texts (de, en): the source notes, rules texts and notices. Default: the instance's language, German.",
            "example": "en",
            "in": "query",
            "name": "lang",
            "schema": {
              "enum": [
                "de",
                "en"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The page, or null.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "required": [
                            "station",
                            "pageUrl",
                            "sections"
                          ],
                          "properties": {
                            "station": {
                              "type": "object"
                            },
                            "pageUrl": {
                              "type": "string"
                            },
                            "sections": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": [
                                  "id",
                                  "asOf",
                                  "sources"
                                ],
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "enum": [
                                      "header",
                                      "rail_ampel",
                                      "step_free_now",
                                      "lifts",
                                      "platforms",
                                      "departures",
                                      "service_alerts",
                                      "parking_charging"
                                    ]
                                  },
                                  "asOf": {
                                    "type": "string"
                                  },
                                  "sources": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      ]
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "No station with this id.",
            "headers": {
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimit-Policy"
              }
            }
          }
        }
      }
    }
  }
}
